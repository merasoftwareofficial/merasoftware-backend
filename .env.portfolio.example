# Add these to the backend/worker environment alongside its existing MONGODB_URI.
# Use the same random secret on the Next.js website.
PORTFOLIO_WEBSITE_URL=https://merasoftware.com
PORTFOLIO_INTEGRATION_SECRET=
# Enable only on the deployed worker that has Chromium installed.
PORTFOLIO_CAPTURE_ENABLED=true
# Run the worker alongside the backend web service, with automatic process restart.
ENABLE_PORTFOLIO_WORKER=true
